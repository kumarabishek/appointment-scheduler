    "@prisma/client": "^7.8.0",
    "chrono-node": "^2.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.31.0",
    "luxon": "^3.5.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
